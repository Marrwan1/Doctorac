class SvgPicture {
  static Widget asset(String path,
      {double? width, double? height, Color? color}) {
    final name = path.split('/').last.replaceAll('.svg', '');
    return Icon(_icons[name],
        size: width ?? height, color: color, textDirection: TextDirection.ltr);
  }
}

