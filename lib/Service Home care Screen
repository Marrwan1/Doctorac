// ───────────────────────── Screen ─────────────────────────
class HomeCareScreen extends StatefulWidget {
  const HomeCareScreen({super.key});

  @override
  State<HomeCareScreen> createState() => _HomeCareScreenState();
}

class _HomeCareScreenState extends State<HomeCareScreen> {
  final _name = TextEditingController();
  final _phone = TextEditingController();
  int? _service, _area, _provider;
  bool _submitted = false;
  String? _open; // which picker sheet is open: 'svc' | 'area' | 'prov'

  // The whole screen is designed at 376 x 840 and scaled to fit any phone,
  // so everything always shows on ONE page, exactly like the design.
  static const double _w = 376;
  static const double _h = 840;

  @override
  void dispose() {
    _name.dispose();
    _phone.dispose();
    super.dispose();
  }

  void _submit() {
    setState(() => _submitted = true);
    final ok = _name.text.trim().isNotEmpty &&
        _phone.text.trim().isNotEmpty &&
        _service != null &&
        _area != null &&
        _provider != null;
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(
      behavior: SnackBarBehavior.floating,
      backgroundColor: C.navy,
      content: Text(ok ? 'تم إرسال طلبك بنجاح' : 'أكمل البيانات المطلوبة',
          textAlign: TextAlign.center),
    ));
    // TODO: send the request to your backend when `ok` is true.
  }

  Widget _sheet() {
    final key = _open!;
    final title = key == 'svc'
        ? 'اختر الخدمة'
        : key == 'area'
            ? 'اختر المنطقة'
            : 'اختر مقدم الخدمة';
    final opts = key == 'svc' ? services : (key == 'area' ? areas : providers);
    final sel = key == 'svc' ? _service : (key == 'area' ? _area : _provider);
    return PickerSheet(
      title: title,
      options: opts,
      selected: sel,
      onClose: () => setState(() => _open = null),
      onSelect: (i) => setState(() {
        if (key == 'svc') {
          _service = i;
        } else if (key == 'area') {
          _area = i;
        } else {
          _provider = i;
        }
        _open = null;
      }),
    );
  }

  Widget _design() {
    const bars = kShowMockBars;
    return SizedBox(
      width: _w,
      height: bars ? _h : _h - 80,
      child: Stack(
        children: [
          // soft blue wave at the bottom
          const Positioned(
            left: -75,
            right: -75,
            bottom: -40,
            height: 150,
            child: DecoratedBox(
              decoration: BoxDecoration(
                color: Color(0xB3E6F0FB),
                borderRadius:
                    BorderRadius.vertical(top: Radius.elliptical(263, 75)),
              ),
            ),
          ),
          Column(
            children: [
              if (bars) const _StatusBar(),
              Expanded(
                child: Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 16),
                  child: Column(
                    children: [
                      const _TopBar(),
                      const _Banner(),
                      const SizedBox(height: 15),
                      _FormCard(
                        children: [
                          FieldShell(
                            icon: 'user',
                            label: 'الاسم الكامل',
                            error: _submitted && _name.text.trim().isEmpty,
                            child: _TextInput(
                                controller: _name,
                                hint: 'ادخل اسمك بالكامل',
                                onChanged: (_) => setState(() {})),
                          ),
                          FieldShell(
                            icon: 'phone',
                            label: 'رقم الموبايل',
                            error: _submitted && _phone.text.trim().isEmpty,
                            child: _TextInput(
                                controller: _phone,
                                hint: 'ادخل رقم الهاتف',
                                keyboard: TextInputType.phone,
                                onChanged: (_) => setState(() {})),
                          ),
                          FieldShell(
                            icon: 'medical-clipboard',
                            label: 'الخدمة المطلوبة',
                            error: _submitted && _service == null,
                            onTap: () => setState(() => _open = 'svc'),
                            child: _Value(
                                text: _service == null
                                    ? 'اختر الخدمة'
                                    : services[_service!]
                                        .label
                                        .replaceAll('\n', ' '),
                                filled: _service != null),
                          ),
                          FieldShell(
                            icon: 'location-1',
                            label: 'المنطقة',
                            error: _submitted && _area == null,
                            onTap: () => setState(() => _open = 'area'),
                            child: _Value(
                                text: _area == null
                                    ? 'اختر المنطقة'
                                    : areas[_area!].label,
                                filled: _area != null),
                          ),
                          FieldShell(
                            icon: 'user',
                            label: 'مقدم الخدمة',
                            error: _submitted && _provider == null,
                            onTap: () => setState(() => _open = 'prov'),
                            child: _Value(
                                text: _provider == null
                                    ? 'اختر مقدم الخدمة'
                                    : providers[_provider!].label,
                                filled: _provider != null),
                          ),
                          _ConfirmButton(onPressed: _submit),
                        ],
                      ),
                      const _Footer(),
                    ],
                  ),
                ),
              ),
              if (bars) const SizedBox(height: 44),
            ],
          ),
          if (_open != null) ...[
            Positioned.fill(
              child: GestureDetector(
                onTap: () => setState(() => _open = null),
                child: const ColoredBox(color: Color(0x8C2D3A50)),
              ),
            ),
            Positioned(left: 0, right: 0, bottom: 0, top: 188, child: _sheet()),
          ],
          if (bars)
            Positioned(
              left: 0,
              right: 0,
              bottom: 0,
              child:
                  _NavBar(bg: _open != null ? const Color(0xFFF0F4FA) : null),
            ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Container(
        width: double.infinity,
        height: double.infinity,
        decoration: const BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
            colors: [Color(0xFFF6F9FE), Color(0xFFF3F8FE), Color(0xFFEAF2FC)],
          ),
        ),
        child: SafeArea(
          top: !kShowMockBars,
          bottom: !kShowMockBars,
          child: Center(
            child: FittedBox(fit: BoxFit.contain, child: _design()),
          ),
        ),
      ),
    );
  }
}

